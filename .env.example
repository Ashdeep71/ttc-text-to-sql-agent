# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Password for transitquery_ro, the read-only database user (db/init/04_roles_password.sh)
TRANSITQUERY_RO_PASSWORD=change-me

# Host port the DB container is published on (docker run -p 5433:5432).
# 5433 avoids clashing with a locally installed Postgres on 5432.
TRANSITQUERY_DB_PORT=5433
